# AI Market Intelligence - Environment Variables Configuration
# THIS IS A SUBMISSION VERSION - Use placeholder values, NEVER commit real API keys!
# For actual use, copy .env.example to .env and add your real API keys

# ============================================================================
# AI API KEYS (at least one recommended for AI insights)
# ============================================================================

# Google Gemini API (Recommended - Free tier available)
# Get your API key at: https://aistudio.google.com/app/apikey
# No credit card required
GEMINI_API_KEY=AIzaSyDq7JRmB9ij7IpPIe68NPal8xifhas3eVo

#OpenAI API (Optional - Requires payment)
# Get your API key at: https://platform.openai.com/api-keys
# $5 free credits for new accounts
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# Hugging Face API (Optional - Free tier available)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_TOKEN_HERE

#

# RapidAPI Key (Optional - for iOS App Store data)
# Get your key at: https://rapidapi.com/
# Free tier available with limited requests
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE

# Kaggle API Credentials (Optional - for programmatic Kaggle access)
# Get credentials at: https://www.kaggle.com/settings
# KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Environment (development, staging, production)
# ENVIRONMENT=development

# Debug mode (true/false)
# DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO



